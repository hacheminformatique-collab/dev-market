# Apache configuration for the Paradise application (React SPA + PHP API).
#
# Requirements: mod_rewrite must be enabled on the server.

Options -Indexes -MultiViews
DirectoryIndex index.html

# ── PHP upload limits (documents clients) ────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 15M
    php_value post_max_size 15M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 15M
    php_value post_max_size 15M
</IfModule>

# ── Compression (mod_deflate) ────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff font/woff2 application/font-woff application/font-woff2
    Header append Vary Accept-Encoding
</IfModule>

# ── Brotli (mod_brotli — if available) ──────────────────────────────────────
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
    AddOutputFilterByType BROTLI_COMPRESS font/woff font/woff2
</IfModule>

# ── Cache-Control headers (LCP on repeat visits) ─────────────────────────────
<IfModule mod_headers.c>
    # Hashed JS/CSS assets: immutable — 1 year
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Fonts: 1 year (rarely change)
    <FilesMatch "\.(woff2?|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Images: 30 days
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|avif|ico|svg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # HTML (index.html): no-cache so SPA always fetches latest shell
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── mod_expires fallback ─────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                  "access plus 0 seconds"
    ExpiresByType text/css                   "access plus 1 year"
    ExpiresByType application/javascript     "access plus 1 year"
    ExpiresByType image/png                  "access plus 30 days"
    ExpiresByType image/jpeg                 "access plus 30 days"
    ExpiresByType image/webp                 "access plus 30 days"
    ExpiresByType image/avif                 "access plus 30 days"
    ExpiresByType image/svg+xml              "access plus 30 days"
    ExpiresByType font/woff2                 "access plus 1 year"
    ExpiresByType font/woff                  "access plus 1 year"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^(?:site-maintenance\.flag|api/site-(?:controls|guard)\.php)$ - [F,L]
    # Serve PHP files in api/ directly — do not rewrite them to index.html
    RewriteRule ^api/ - [L]

    RewriteCond %{DOCUMENT_ROOT}/site-maintenance.flag -f
    RewriteRule ^((?!assets/|media/|favicon[^/]*$|robots\.txt$|storage-data/).*)$ api/site-router.php?route=$1 [L]
    RewriteRule ^((?:admin|dashboard)/?)$ api/site-router.php?route=$1 [L]
    # A missing publication manifest must return 404, not the SPA shell.
    RewriteRule ^(?:wedding-pages\.json|wedding-city-aliases\.json|wedding-departments\.json|wedding-directory(?:-idf)?\.html)$ - [L]

    # Blog pages receive the regional directory in their initial HTML.
    RewriteRule ^blog(?:/.*)?$ api/blog-shell.php [L]

    RewriteCond %{THE_REQUEST} \s/+locationsalledemariage/departements/([0-9]{2})(?:\.html|/)(?:[?\s]) [NC]
    RewriteRule ^locationsalledemariage/departements/([0-9]{2})(?:\.html|/)$ /locationsalledemariage/departements/$1 [R=301,L]
    RewriteCond %{DOCUMENT_ROOT}/locationsalledemariage/departements/$1.html -f
    RewriteRule ^locationsalledemariage/departements/([0-9]{2})$ locationsalledemariage/departements/$1.html [L]
    # Unpublished departments must not return the homepage with a 200 status.
    RewriteRule ^locationsalledemariage/departements/ - [L]

    # Keep the existing extensionless canonical URLs for published city files.
    # Historical city names redirect to the postcode URL only after publication.
    RewriteCond %{REQUEST_URI} !-[0-9]{5}(?:\.html|/)?$
    RewriteCond %{DOCUMENT_ROOT}/wedding-city-aliases.json -f
    RewriteRule ^(locationsalle[a-z]+)/([a-z0-9-]+)(?:\.html|/)?$ api/city-redirect.php?type=$1&slug=$2 [L]
    RewriteCond %{THE_REQUEST} \s/+locationsalledemariage/([a-z0-9-]+)(?:\.html|/)(?:[?\s]) [NC]
    RewriteCond %{DOCUMENT_ROOT}/locationsalledemariage/$1.html -f
    RewriteRule ^locationsalledemariage/([a-z0-9-]+)(?:\.html|/)$ /locationsalledemariage/$1 [R=301,L]

    RewriteCond %{DOCUMENT_ROOT}/locationsalledemariage/$1.html -f
    RewriteRule ^locationsalledemariage/([a-z0-9-]+)$ locationsalledemariage/$1.html [L]
    RewriteRule ^(locationsalledemariage/[a-z0-9-]+)$ api/site-router.php?route=$1 [L]

    # Let static assets (js, css, images…) be served directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Fall back to index.html for all other routes (React Router SPA)
    RewriteRule ^(.*)$ api/site-router.php?route=$1 [L]
</IfModule>
